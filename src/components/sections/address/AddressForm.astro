---
import { states, type State } from "../../../utils/data/states";

interface Props {
  type: "shipping" | "billing";
}

const { type } = Astro.props;
---

<div class="address-form-container">
  <div class="title-bar">
    <h2>3. Tell Us Where To Ship</h2>
  </div>
  <form class="address-form" data-form-type={type}>
    <div class="form-field">
      <input
        type="email"
        id={`email-${type}`}
        name="email"
        placeholder="Email Address"
        required
        class="address-input"
        data-validate="email"
      />
    </div>
    <div class="name-fields">
      <div class="input-group">
        <input
          type="text"
          id={`firstName-${type}`}
          name="firstName"
          placeholder="First Name"
          required
          maxlength="50"
          class="address-input"
          data-validate="firstName"
        />
      </div>
      <div class="input-group">
        <input
          type="text"
          id={`lastName-${type}`}
          name="lastName"
          placeholder="Last Name"
          required
          maxlength="50"
          class="address-input"
          data-validate="lastName"
        />
      </div>
    </div>

    <label for={`${type}-country`}>Country/Region</label>
    <select id={`${type}-country`} name="country" required>
      <option value="US" selected>United States</option>
    </select>

    <div class="input-group">
      <input
        type="text"
        id={`address1-${type}`}
        name="address1"
        placeholder="Address Line 1"
        required
        class="address-input"
        data-validate="address"
      />
    </div>

    <input
      type="text"
      id={`address2-${type}`}
      name="address2"
      placeholder="Address Line 2 (Optional)"
      class="address-input"
      data-validate="address"
    />

    <div class="city-state-zip">
      <div class="input-group">
        <input
          type="text"
          id={`city-${type}`}
          name="city"
          placeholder="City"
          required
          minlength="1"
          maxlength="50"
          class="address-input"
          data-validate="city"
        />
      </div>

      <select id={`state-${type}`} name="state" required>
        <option value="" disabled selected>State</option>
        {
          states.map((state: State) => (
            <option value={state.abbreviation}>{state.name}</option>
          ))
        }
      </select>

      <div class="input-group">
        <input
          type="text"
          id={`zip-${type}`}
          name="zipCode"
          placeholder="Zip Code"
          required
          class="address-input"
          maxlength="10"
          data-validate="zipCode"
        />
      </div>
    </div>

    <div class="input-group">
      <input
        type="tel"
        id={`phone-${type}`}
        name="phone"
        placeholder="Phone Number"
        required
        class="address-input"
        data-validate="phoneNumber"
      />

      <div class="mb-4 mt-6">
        <button type="button" id={`showPaymentBtn-${type}`} class="cta-button">
          Continue to Payment <span class="arrow">→</span>
        </button>
      </div>
    </div>
  </form>
</div>

<style>
  @import "/style/AddressForm.css";
</style>

<script>
  // Import validation rules
  import { validationRules } from "../../../utils/validation/validationRules";

  document.addEventListener("DOMContentLoaded", () => {
    // Select all address forms on the page
    const addressForms = document.querySelectorAll(".address-form");

    addressForms.forEach((form) => {
      const formElement = form as HTMLFormElement;
      const formType = formElement.getAttribute("data-form-type") || "";
      const showPaymentBtn = formElement.querySelector(
        `#showPaymentBtn-${formType}`,
      );
      const paymentFormSection = document.getElementById("paymentFormSection"); // Assuming this is a single element outside the form component

      // Get all form inputs that need validation using the data-validate attribute
      const inputsToValidate = formElement.querySelectorAll(
        "[data-validate]",
      ) as NodeListOf<HTMLInputElement>;

      // Centralized validation function
      const validateInput = (input: HTMLInputElement) => {
        const validationKey = input.getAttribute("data-validate");
        if (!validationKey || !validationRules[validationKey]) {
          input.setCustomValidity(""); // Clear any previous custom validity
          return true; // No validation rule, consider valid
        }

        const { validator, errorMessage } = validationRules[validationKey];
        const isValid = validator(input.value);
        input.setCustomValidity(isValid ? "" : errorMessage);
        return isValid;
      };

      // Setup validation for each input with data-validate attribute
      inputsToValidate.forEach((input) => {
        // Validate on input
        input.addEventListener("input", function () {
          if (this.value === "") {
            this.setCustomValidity("");
            return;
          }
          validateInput(this);
        });

        // Validate on blur (when leaving the field)
        input.addEventListener("blur", function () {
          if (this.value === "") return;
          const isValid = validateInput(this);
          if (!isValid) {
            this.reportValidity();
          }
        });
      });

      if (showPaymentBtn && paymentFormSection && formElement) {
        showPaymentBtn.addEventListener("click", (e) => {
          e.preventDefault();

          // Validate all fields manually before proceeding
          let allInputsValid = true;
          inputsToValidate.forEach((input) => {
            // Check if the input is required and empty, or if it has a value and fails validation
            if (input.required && input.value.trim() === "") {
              allInputsValid = false;
              validateInput(input); // Trigger validation message for empty required fields
            } else if (input.value.trim() !== "") {
              if (!validateInput(input)) {
                allInputsValid = false;
              }
            }
          });

          // Use HTML5 form validation as a fallback/additional check
          const isFormValid = formElement.checkValidity();

          if (!allInputsValid || !isFormValid) {
            // Force the form to show validation messages
            formElement.reportValidity();

            // Find the first invalid field and focus it
            const firstInvalidField = formElement.querySelector(
              ":invalid",
            ) as HTMLInputElement;
            if (firstInvalidField) {
              firstInvalidField.focus();
            }
          } else {
            // All fields are valid, proceed to payment
            paymentFormSection.classList.remove("hidden");
            paymentFormSection.scrollIntoView({ behavior: "smooth" });

            // Trigger Braintree initialization
            document.dispatchEvent(new CustomEvent("payment-form-visible"));
          }
        });
      }
    });
  });
</script>
