---
import Layout from "../layouts/Layout-Home.astro";
import Hero from "../components/sections/hero/Hero.astro";
import Brands from "../components/sections/brands/Brands.astro";
import Solutions from "../components/sections/solutions/Solutions.astro";
import Features from "../components/sections/features/Features.astro";
import LazyLoad from "../components/shared/LazyLoad.astro";

// Dynamic imports for components below the fold
const Testimonials = (await import("../components/sections/testimonials/Testimonials.astro")).default;
const FAQ = (await import("../components/sections/faq/FAQ.astro")).default;
---

<Layout title="Barefoot Shoes">
  <main class="flex flex-col overflow-hidden">
    <Hero className="pb-8" />
    <Brands className="py-8" />
    <Features className="py-8" />
    <Solutions className="py-8" />
    <LazyLoad>
      <Testimonials className="py-8" />
    </LazyLoad>
    <LazyLoad>
      <FAQ className="py-8" />
    </LazyLoad>
  </main>
</Layout>
