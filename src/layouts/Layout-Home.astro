---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import Banner from "../components/shared/Banner.astro";

// eslint-disable-next-line @typescript-eslint/no-empty-interface, @typescript-eslint/no-empty-object-type
export interface Props {
  title: string;
}

// eslint-disable-next-line no-empty-pattern
const { title } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Barefoot Shoes" />
    <title>{title}</title>
    <link rel="stylesheet" href="/style/custom.css" />
  </head>
  <body
    class="overflow-hidden overflow-y-auto bg-body font-sans"
    data-theme="light"
  >
    <Banner />
    <Navbar />
    <slot />
    <Footer />
  </body>
  <script>
    // Load non-critical scripts after the page is interactive
    function loadScripts() {
      // Scroll handling
      let lastScrollY = window.scrollY;
      const banner = document.getElementById("banner");
      const navbar = document.getElementById("navbar");

      const w = window as Window & typeof globalThis;
      (w as Window).addEventListener("scroll", () => {
        const currentScrollY = w.scrollY;
        if (currentScrollY > lastScrollY) {
          if (banner) banner.style.transform = "translateY(0)";
          if (navbar) navbar.style.transform = "translateY(0)";
        }
        lastScrollY = currentScrollY;
      });

      // Load analytics when idle
      if ('requestIdleCallback' in w) {
        (w as Window).requestIdleCallback(loadAnalytics, { timeout: 2000 });
      } else {
        (w as Window).addEventListener('load', () => {
          setTimeout(loadAnalytics, 2000);
        });
      }
    }

    // Load analytics scripts
    function loadAnalytics() {
      // Example: Load Google Analytics
      // const script = document.createElement('script');
      // script.async = true;
      // script.src = 'https://www.googletagmanager.com/gtag/js?id=YOUR-GA-ID';
      // document.head.appendChild(script);
      
      // Initialize analytics here if needed
      // window.dataLayer = window.dataLayer || [];
      // function gtag(){dataLayer.push(arguments);}
      // gtag('js', new Date());
      // gtag('config', 'YOUR-GA-ID');
    }

    // Run after DOM is fully loaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadScripts);
    } else {
      loadScripts();
    }
  </script>
  <script>
    const toggleMenu = document.querySelector(
      "[data-toggle-nav]",
    ) as HTMLButtonElement;
    const navbar = document.querySelector("[data-navbar]") as HTMLDivElement;
    const overlayNav = document.querySelector(
      "[data-nav-overlay]",
    ) as HTMLDivElement;
    if (toggleMenu) {
      toggleMenu.addEventListener("click", (e) => {
        e.preventDefault();
        if (toggleMenu.getAttribute("data-open-nav") === "false") {
          toggleMenu.setAttribute("data-open-nav", "true");
          overlayNav.setAttribute("data-is-visible", "true");
          document.body.classList.add("!overflow-y-hidden");
          navbar.style.height = `${navbar.scrollHeight}px`;
        } else {
          toggleMenu.setAttribute("data-open-nav", "false");
          overlayNav.setAttribute("data-is-visible", "false");
          document.body.classList.remove("!overflow-y-hidden");
          navbar.style.height = "0";
        }
      });

      navbar.addEventListener("click", () => {
        toggleMenu.setAttribute("data-open-nav", "false");
        overlayNav.setAttribute("data-is-visible", "false");
        document.body.classList.remove("!overflow-y-hidden");
        navbar.style.height = "0px";
      });

      overlayNav.addEventListener("click", () => {
        toggleMenu.setAttribute("data-open-nav", "false");
        overlayNav.setAttribute("data-is-visible", "false");
        document.body.classList.remove("!overflow-y-hidden");
        navbar.style.height = "0px";
      });
    }
  </script>
</html>
